# Optional: Supabase sync for quote history + sales tracker (same browser profile).
# Create a project at https://supabase.com → Settings → API.
# Enable Auth → Providers → Anonymous sign-in.
# Run the SQL in supabase/migrations/20260417140000_user_app_data.sql (SQL editor or CLI).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional analytics (leave unset to skip)
# VITE_ANALYTICS_ENDPOINT=
# VITE_ANALYTICS_WEBSITE_ID=
